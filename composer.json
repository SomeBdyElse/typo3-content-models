{
  "name": "somebdyelse/typo3-content-models",
  "description": "TYPO3 Content Models",
  "extra": {
    "typo3/cms": {
      "extension-key": "content_models",
      "web-dir": ".Build/Web"
    }
  },
  "keywords": ["typo3", "extension", "composer.json"],
  "authors": [
    {
      "name": "Hannes Lau",
      "email": "office@hanneslau.de"
    }
  ],
  "license": "GPL-2.0+",
  "type": "typo3-cms-extension",
  "require": {
    "nette/php-generator": "^4.2.0",
    "typo3/cms-core": "^v13.4.0 | ^14.0",
    "typo3/cms-extbase": "^v13.4.0 | ^14.0",
    "typo3/cms-frontend": "^v13.4.0 | ^14.0"
  },
  "autoload": {
    "psr-4": {
      "SomeBdyElse\\Typo3ContentModels\\": "Classes/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "SomeBdyElse\\Typo3ContentModels\\Tests\\": "Tests/"
    }
  },
  "require-dev": {
    "phpstan/phpstan": "^2.2",
    "phpunit/phpunit": "^11.5 || ^12.0 || ^13.0",
    "typo3/cms-felogin": "^13.4 || ^14.0",
    "typo3/cms-fluid-styled-content": "^13.4 || ^14.0",
    "typo3/cms-form": "^13.4 || ^14.0",
    "typo3/cms-indexed-search": "^13.4 || ^14.0",
    "typo3/cms-install": "^13.4 || ^14.0",
    "typo3/cms-seo": "^13.4 || ^14.0",
    "typo3/cms-styleguide": "^13.4 || ^14.0",
    "typo3/coding-standards": "^0.9.0",
    "typo3/testing-framework": "^9.0"
  },
  "scripts": {
    "test:functional": "typo3DatabaseDriver=pdo_sqlite php .Build/bin/phpunit -c Build/phpunit/FunctionalTests.xml"
  },
  "config": {
    "vendor-dir": ".Build/vendor",
    "bin-dir": ".Build/bin",
    "allow-plugins": {
      "typo3/cms-composer-installers": true,
      "typo3/class-alias-loader": true
    }
  }
}
